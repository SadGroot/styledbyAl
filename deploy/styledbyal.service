[Unit]
Description=Styled by Al portfolio and private studio
After=network.target

[Service]
Type=simple
User=styledbyal
Group=styledbyal
WorkingDirectory=/opt/styledbyal/current
EnvironmentFile=/etc/styledbyal/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/local/bin/styledbyal-node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=4096
MemoryMax=800M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/styledbyal
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
